{
    "name": "jeffersongoncalves/filament-documentation",
    "description": "A Filament plugin to add markdown-based documentation to your admin panel.",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "documentation",
        "markdown",
        "docs",
        "admin-panel"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "league/commonmark": "^2.4",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/yaml-front-matter": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentDocumentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentDocumentation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\FilamentDocumentation\\FilamentDocumentationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
